##############################################################
# IMAGE FOR BUILDING

FROM cokoapps/base:24

RUN corepack enable
WORKDIR /home/node/app

COPY package.json .
COPY yarn.lock .
COPY .yarnrc.yml .

RUN yarn install --immutable

COPY . .

RUN yarn build

##############################################################
# IMAGE FOR RUNNING

FROM cokoapps/base:24

WORKDIR /home/node/app

RUN yarn global add serve

COPY --from=0 /home/node/app/build ./build

RUN chown -R node:node .
USER node

CMD ["npx", "serve", "-p", "3000", "./build"]

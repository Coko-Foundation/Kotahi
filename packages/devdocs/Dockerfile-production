##############################################################
# IMAGE FOR BUILDING

FROM cokoapps/base:24

RUN corepack enable
WORKDIR /home/node/app

COPY package.json .
COPY yarn.lock .
COPY .yarnrc.yml .

RUN yarn install --immutable

COPY . .

RUN yarn build

##############################################################
# IMAGE FOR RUNNING

FROM cokoapps/base:24

COPY --from=0 /home/node/app/build /usr/share/nginx/html
